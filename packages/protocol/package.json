{
  "name": "@triargos/live-collection-protocol",
  "version": "3.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Shared contract kit for the live-collection sync system: wire schemas, sync-group routing keys, the squasher, expected interface types, and the /catchup request/response schemas. Imported by both the frontend library and the backend.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/triargos/live-collection.git",
    "directory": "packages/protocol"
  },
  "scripts": {
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "build": "tsc -b",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "effect": "catalog:"
  }
}
