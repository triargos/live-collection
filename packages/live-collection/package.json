{
  "name": "@triargos/live-collection",
  "version": "3.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Frontend live-sync engine: collection registry + scoping, persistence factory (TanStack DB), SSE/catchup client, sync broker, and bootstrap orchestration. Hero type: LiveCollection<T>.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/triargos/live-collection.git",
    "directory": "packages/live-collection"
  },
  "scripts": {
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "build": "tsc -b",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@tanstack/db": "catalog:",
    "@tanstack/db-sqlite-persistence-core": "catalog:",
    "@triargos/live-collection-protocol": "workspace:^",
    "effect": "catalog:"
  },
  "dependencies": {
    "idb": "catalog:"
  },
  "devDependencies": {
    "@tanstack/db": "catalog:",
    "@tanstack/db-sqlite-persistence-core": "catalog:",
    "@triargos/live-collection-protocol": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:"
  }
}
